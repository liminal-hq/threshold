<?xml version="1.0" encoding="utf-8"?>
<!-- Base fill colour follows values/ vs values-night/; NextAlarmWidget.applyPalette always retints this drawable's ImageView with a colour filter (rail or railMuted) on every render, so this solid colour only ever shows before the first render. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_rail_colour" />
    <corners android:radius="1.5dp" />
</shape>
