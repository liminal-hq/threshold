<?xml version="1.0" encoding="utf-8"?>
<!-- Hero 4x2 layout. Root is a FrameLayout stacking a themed background image behind the
     horizontal rail-plus-text content row, rather than putting the background drawable directly
     on the content group - a colour filter applied to a dedicated ImageView flattens the theme
     fill onto the card deterministically on every render, which a drawable background attribute
     can't do once a filter has to be reapplied or cleared between renders. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_stroke"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_background_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_fill"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/widget_rail"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:src="@drawable/widget_rail_shape"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_eyebrow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:singleLine="true"
                android:importantForAccessibility="no"
                android:textColor="@color/widget_eyebrow_colour" />

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="40sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:importantForAccessibility="no"
                android:textColor="@color/widget_time_colour" />

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:textColor="@color/widget_label_colour"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
