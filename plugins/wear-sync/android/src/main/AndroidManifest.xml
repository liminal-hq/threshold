<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <activity
            android:name=".WearSyncBootstrapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".WearMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/threshold/" />
            </intent-filter>
        </service>

        <service
            android:name=".WearSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Spike-only (issue #255 Phase 0): exists purely to prove that a manifest-declared
             ContentProvider's onCreate() runs before AlarmReceiver.onReceive() on a cold
             process start, before the later phases of the shared native event bus design
             depend on that ordering. See docs/spikes/255-contentprovider-spike-protocol.md
             and BusInitProvider.kt. Not a real content provider: exported="false" and it
             has no callers. -->
        <provider
            android:name=".BusInitProvider"
            android:authorities="${applicationId}.wearsync-bus-spike-init"
            android:exported="false" />
    </application>
</manifest>
